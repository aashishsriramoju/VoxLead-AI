# .gitignore – Files that must never reach version control

# Secrets
.env

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Database (contains real customer data)
*.db
*.sqlite
*.sqlite3

# RAG embedding cache (can be regenerated)
knowledge_base/.cache.json

# Node / React
node_modules/
dist/
.vite/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
