# .env.example – Copy this to .env and fill in your real values.
# NEVER commit .env to version control.

# Google Gemini API key – get one free at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Models (defaults shown; change only if Google updates names)
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# SQLite database path (relative to backend/)
DATABASE_URL=sqlite:///./voxlead.db

# RAG settings
RAG_SIMILARITY_THRESHOLD=0.60
RAG_TOP_K=4
